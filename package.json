{
  "name": "create-nest-architect",
  "version": "1.0.8",
  "description": "A simple CLI that creates a new project for NestJS with an architecture of your choice and orm or odm configured",
  "homepage": "https://github.com/MGardier/create-nest-architect#readme",
  "bugs": {
    "url": "https://github.com/MGardier/create-nest-architect/issues"
  },
  "main": "./dist/cli.js",
  "bin": {
    "create-nest-architect": "./dist/cli.js"
  },
  "scripts": {
    "build": "npx tsx scripts/build.ts",
    "dev": "npx tsx src/cli.ts",
    "typecheck:tests": "npx tsc --noEmit -p tsconfig.tests.json",
    "test:unit": "npx tsx --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && npm run typecheck:tests && npx tsx --test tests/e2e/scaffold.e2e.test.ts",
    "prepublishOnly": "npm run build"
  },
  "author": "Maxime Gardier",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.13",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "prompts": "^2.4.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MGardier/create-nest-architect.git"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "nestjs",
    "nest",
    "cli",
    "generator",
    "template",
    "boilerplate",
    "scaffold",
    "architecture",
    "clean-architecture",
    "prisma",
    "mongoose",
    "orm",
    "odm",
    "typescript",
    "nodejs",
    "backend",
    "api",
    "crud",
    "starter",
    "developer-tools"
  ],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
